# Copy to .env and fill in. Never commit .env or expose these values to the browser.
# The operator owns the provider keys; users only upload their files.

# --- AI providers (required unless DEMO_MODE=true) ---
# Extraction + image agents: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Validation, suggestions and synthesis: https://console.groq.com/keys
GROQ_API_KEY=

# Optional model overrides. The browser never selects a model.
# Free vision model. Its reasoning tokens count toward max_tokens. Free tiers are rate-limited;
# a paid vision model is more reliable for a busy production deployment.
# EXTRACTION_MODEL=nvidia/nemotron-3.5-super-vl:free
# Validation, suggestions and synthesis. Fast and JSON-reliable; Groq's free tier has a low
# output-token limit, so large reviews take longer. Paid tiers remove that bottleneck.
# REASONING_MODEL=qwen/qwen3.8-27b

# Explicit offline demo. Clearly labelled in the UI. Never a silent fallback.
DEMO_MODE=false

# --- Request limits (per process) ---
# MAX_REQUEST_BYTES=20971520
# MAX_PROMPT_CHARS=200000
# MAX_MESSAGES=24
# MAX_IMAGES=6
# MAX_OUTPUT_TOKENS=8192
# MAX_CONCURRENT_CALLS=8
# RATE_LIMIT_PER_MINUTE=60
# RATE_LIMIT_PER_HOUR=600
# RATE_LIMIT_PER_DAY=2000
# UPSTREAM_TIMEOUT=180
# UPSTREAM_RETRIES=1
# UPSTREAM_RETRY_DELAY=2

# --- Deployment ---
# Only needed when the frontend is hosted on a different origin than the API.
# CORS_ORIGINS=https://app.example.com
# Comma-separated host names accepted by the API (recommended in production).
# TRUSTED_HOSTS=inkroom.example.com
# Sent to OpenRouter as the referring site.
# PUBLIC_APP_URL=https://inkroom.example.com
# Only set this when a trusted proxy sets X-Forwarded-For; otherwise clients can
# spoof their address and bypass per-IP rate limits. Render sets "*" in its blueprint.
# FORWARDED_ALLOW_IPS=127.0.0.1

# --- Docker Compose only ---
# The app is published on loopback by default. Set BIND_ADDRESS=0.0.0.0 only when
# you intentionally want direct public access without a reverse proxy.
# BIND_ADDRESS=127.0.0.1
# APP_PORT=8000
